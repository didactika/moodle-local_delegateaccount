{{!
    @template local_delegateaccount/delegations/page

    The delegations of one person: who they are, whether they may still use them, and the list of their delegations.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "backurl": "https://moodle.example/local/delegateaccount/pages/manage.php",
        "user": {
            "fullname": "Jane Doe",
            "email": "jane@example.com",
            "hasimage": false,
            "initials": "JD",
            "size": 50
        },
        "authorised": true,
        "cancreate": true,
        "realuserid": 7,
        "create": "<button type=\"button\" class=\"btn btn-primary\">Create</button>",
        "list": "<div></div>"
    }
}}
<div class="lda">
    <a class="btn btn-link px-0" href="{{backurl}}">{{#pix}}i/previous, core{{/pix}} {{#str}}back_to_manage, local_delegateaccount{{/str}}</a>
    <header class="dd-page-header">
        <div class="dd-page-header-row">
            <div class="dd-page-header-main">
                {{#user}}{{> local_delegateaccount/shared/avatar }}{{/user}}
                <div>
                    <p class="dd-page-title">{{user.fullname}}</p>
                    <p class="dd-page-subtitle">{{user.email}}</p>
                </div>
            </div>
            <div class="dd-page-actions">
                {{{create}}}
            </div>
        </div>
    </header>
    {{^authorised}}
        <div class="alert alert-warning mb-0">{{#str}}delegations_user_not_authorised, local_delegateaccount{{/str}}</div>
    {{/authorised}}
    {{{list}}}
</div>
