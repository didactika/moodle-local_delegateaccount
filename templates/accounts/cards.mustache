{{!
    @template local_delegateaccount/accounts/cards

    One page of the accounts a person may open: a card for each, with until when and the button that opens it.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "rows": [
            {
                "user": {
                    "fullname": "John Smith",
                    "email": "john@example.com",
                    "hasimage": false,
                    "initials": "JS",
                    "size": 50
                },
                "end": "30 November 2026",
                "hasend": true,
                "loginurl": "https://moodle.example/local/delegateaccount/pages/loginas.php?id=8&sesskey=x",
                "loginlabel": "Use delegated account: John Smith"
            }
        ]
    }
}}
<ul class="row list-unstyled mb-0">
    {{#rows}}
        <li class="col-sm-6 col-xl-4 mb-3">
            <div class="card h-100"><div class="card-body d-flex flex-column">
            <div class="d-flex align-items-center mb-3">
                {{#user}}{{> local_delegateaccount/shared/avatar }}{{/user}}
                <div class="d-flex flex-column">
                    <p class="card-title mb-0 text-truncate">{{user.fullname}}</p>
                    <span class="small text-muted text-truncate">{{user.email}}</span>
                </div>
            </div>
            <span class="d-flex flex-column mb-3"><small class="text-muted">{{#str}}delegation_end, local_delegateaccount{{/str}}</small>{{end}}</span>
            <a class="btn btn-primary btn-tonal mt-auto align-self-start" href="{{loginurl}}" title="{{loginlabel}}">{{#pix}}i/switch, core{{/pix}} {{#str}}open_account, local_delegateaccount{{/str}}</a>
            </div></div>
        </li>
    {{/rows}}
</ul>
