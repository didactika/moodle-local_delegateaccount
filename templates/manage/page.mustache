{{!
    @template local_delegateaccount/manage/page

    The management page: what it is for and its main action, the tabs of the people who may use delegations, of the ones
    who lost the permission and of every delegation, and the list of the open tab.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "cancreate": true,
        "settingsurl": "https://moodle.example/admin/settings.php?section=local_delegateaccount_settings",
        "hint": "",
        "description": "All active users who currently have permission to use delegated accounts.",
        "tabs": [
            {
                "key": "authorised",
                "label": "Authorised users",
                "url": "https://moodle.example/local/delegateaccount/pages/manage.php",
                "active": true
            },
            {
                "key": "delegations",
                "label": "All delegations",
                "url": "https://moodle.example/local/delegateaccount/pages/manage.php?tab=delegations",
                "active": false
            }
        ],
        "people": {
            "id": "lda-people",
            "config": "{}",
            "searchlabel": "Search people"
        }
    }
}}
<div class="lda">
    <header class="dd-page-header">
        <div class="dd-page-header-row">
            <div class="dd-page-header-main">
                <span class="dd-tile dd-tile-lg">{{#pix}}i/switch, core{{/pix}}</span>
                <p class="dd-page-subtitle">{{#str}}manage_accounts_subtitle, local_delegateaccount{{/str}}</p>
            </div>
            <div class="dd-page-actions">
                {{#settingsurl}}
                    <a class="btn btn-outline-secondary" href="{{settingsurl}}">{{#pix}}i/settings, core{{/pix}} {{#str}}settings{{/str}}</a>
                {{/settingsurl}}
                {{#cancreate}}
                    <button type="button" class="btn btn-primary" data-action="local-delegateaccount-create" data-realuserid="0">{{#pix}}t/add, core{{/pix}} {{#str}}create_delegations, local_delegateaccount{{/str}}</button>
                {{/cancreate}}
            </div>
        </div>
    </header>
    {{#hint}}<div class="alert alert-info mb-0">{{{hint}}}</div>{{/hint}}
    <nav aria-label="{{#str}}manage_accounts, local_delegateaccount{{/str}}">
        <ul class="nav nav-tabs">
            {{#tabs}}
                <li class="nav-item">
                    <a class="nav-link{{#active}} active{{/active}}" href="{{url}}"{{#active}} aria-current="page"{{/active}}>{{label}}</a>
                </li>
            {{/tabs}}
        </ul>
    </nav>
    <p class="dd-page-subtitle mb-0">{{description}}</p>
    {{#people}}{{> local_delegateaccount/list/people }}{{/people}}
    {{#delegations}}{{> local_delegateaccount/list/delegations }}{{/delegations}}
</div>
