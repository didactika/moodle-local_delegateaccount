{{!
    @template local_delegateaccount/manage/actions

    Moodle-native actions and collapsible filters for delegation management.

    @author     Hector Arrechea <hectorlazaroarrechea@gmail.com>
    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "cancreate": true,
        "assignurl": "https://moodle.example/local/delegateaccount/assign.php",
        "addlabel": "Add delegated account",
        "filterid": "local-delegateaccount-manage-filters",
        "filterlabel": "Filters",
        "filterform": "<form><input type=\"text\" aria-label=\"Search\"></form>",
        "hasfilters": false,
        "showfilters": false,
        "reseturl": "https://moodle.example/local/delegateaccount/manage.php",
        "resetlabel": "Reset"
    }
}}
<div class="reportbuilder-wrapper">
    <div class="d-flex flex-wrap justify-content-end mb-3">
        {{#cancreate}}
            <a class="btn btn-primary mr-2" href="{{assignurl}}"
                data-action="local-delegateaccount-open-assign">{{addlabel}}</a>
        {{/cancreate}}
        {{> local_delegateaccount/shared/filter_dropdown}}
    </div>
</div>
