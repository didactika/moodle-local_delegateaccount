{{!
    @template local_delegateaccount/manage_filters

    Search controls for the delegated-account user overview.

    @author     Hector Arrechea <hectorlazaroarrechea@gmail.com>
    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "formurl": "https://moodle.example/local/delegateaccount/manage.php",
        "search": "Jane",
        "clearurl": "https://moodle.example/local/delegateaccount/manage.php",
        "showclear": true
    }
}}
<form method="get" action="{{formurl}}" class="mb-3" role="search">
    <div class="form-row align-items-end">
        <div class="col-sm-6 col-md-5">
            <label for="local-delegateaccount-search">{{#str}}search_authorised_users, local_delegateaccount{{/str}}</label>
            <input type="search" class="form-control" id="local-delegateaccount-search" name="search" value="{{search}}">
        </div>
        <div class="col-auto mt-2 mt-sm-0">
            <button type="submit" class="btn btn-secondary">{{#str}}search, core{{/str}}</button>
            {{#showclear}}
                <a class="btn btn-outline-secondary" href="{{clearurl}}">{{#str}}clear, core{{/str}}</a>
            {{/showclear}}
        </div>
    </div>
</form>
