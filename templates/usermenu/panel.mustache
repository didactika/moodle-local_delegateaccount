{{!
    @template local_delegateaccount/usermenu/panel

    Delegated-account submenu matching Moodle's native user-menu carousel.

    @author     Hector Arrechea <hectorlazaroarrechea@gmail.com>
    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "title": "Delegated accounts",
        "items": [
            {
                "url": "https://moodle.example/local/delegateaccount/pages/loginas.php?id=8",
                "title": "Use delegated account: Example user",
                "text": "Example user"
            }
        ],
        "hasmore": true,
        "viewallurl": "https://moodle.example/local/delegateaccount/pages/accounts.php",
        "viewalllabel": "View all delegated accounts"
    }
}}
<div id="carousel-item-delegatedaccounts" role="menu" class="carousel-item submenu" tabindex="-1"
    aria-label="{{title}}">
    <div class="d-flex flex-column h-100">
        <div class="header">
            <button type="button" class="btn btn-icon carousel-navigation-link text-decoration-none text-body"
                data-carousel-target-id="carousel-item-main" aria-label="{{#str}}usermenugoback{{/str}}">
                <span class="dir-rtl-hide">{{#pix}}i/arrow-left{{/pix}}</span>
                <span class="dir-ltr-hide">{{#pix}}i/arrow-right{{/pix}}</span>
            </button>
            <span class="ps-2" id="carousel-item-title-delegatedaccounts">{{title}}</span>
        </div>
        <div class="dropdown-divider"></div>
        <div class="items h-100 overflow-auto" role="menu"
            aria-labelledby="carousel-item-title-delegatedaccounts">
            {{#items}}
                <a href="{{{url}}}" class="dropdown-item ps-5" role="menuitem" tabindex="-1" title="{{title}}">
                    {{text}}
                </a>
            {{/items}}
            {{#hasmore}}
                <div class="dropdown-divider"></div>
                <a href="{{{viewallurl}}}" class="dropdown-item ps-5" role="menuitem" tabindex="-1">
                    {{viewalllabel}}
                </a>
            {{/hasmore}}
        </div>
    </div>
</div>
