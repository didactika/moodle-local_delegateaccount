<div class="reportbuilder-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a class="btn btn-secondary" href="{{backurl}}">
            {{#pix}}t/left, core{{/pix}}
            {{backlabel}}
        </a>
        <div class="d-flex align-items-center">
            {{#canrevoke}}
                <button type="button" class="btn btn-danger mr-2"
                    data-action="local-delegateaccount-revoke-selected" disabled>
                    {{#pix}}t/delete, core, {{revokeselectedlabel}}{{/pix}}
                    {{revokeselectedlabel}}
                </button>
            {{/canrevoke}}
            {{#cancreate}}
                <a class="btn btn-primary mr-2" href="{{assignurl}}">{{addlabel}}</a>
            {{/cancreate}}
            {{> local_delegateaccount/filter_dropdown}}
        </div>
    </div>
</div>
<div data-region="local-delegateaccount-revoke-config"
    data-post-url="{{posturl}}"
    data-sesskey="{{sesskey}}"
    data-confirm-title="{{confirmtitle}}"
    data-confirm-single="{{confirmsingle}}"
    data-confirm-bulk="{{confirmbulk}}"
    data-confirm-button="{{confirmbutton}}"></div>
