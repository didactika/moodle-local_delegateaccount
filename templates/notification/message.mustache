{{!
    @template local_delegateaccount/notification/message

    HTML message sent for a delegated account lifecycle action.

    @author     Hector Arrechea <hectorlazaroarrechea@gmail.com>
    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "hascustomcontent": false,
        "greeting": "Hello Jane Doe,",
        "accessgranted": "Delegated account access has been granted.",
        "accountaccess": "You can now access John Doe at Example Moodle.",
        "accessstarts": "Access starts:",
        "timestart": "Friday, 21 August 2026, 10:00 AM",
        "accessends": "Access ends:",
        "timeend": "Never",
        "supportmessage": "If you do not expect this access, contact your site administrator."
    }
}}
{{#hascustomcontent}}
    {{{customcontent}}}
{{/hascustomcontent}}
{{^hascustomcontent}}
    <p>{{greeting}}</p>
    <p><strong>{{accessgranted}}</strong></p>
    <p>{{accountaccess}}</p>
    <p><strong>{{accessstarts}}</strong> {{timestart}}<br><strong>{{accessends}}</strong> {{timeend}}</p>
    <p>{{supportmessage}}</p>
{{/hascustomcontent}}
