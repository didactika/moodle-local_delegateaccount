{{!
    @template local_delegateaccount/shared/person

    A person in a row: picture or initials, their name as a link, and their email under it.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "fullname": "Jane Doe",
        "email": "jane@example.com",
        "hasimage": false,
        "imageurl": "",
        "initials": "JD",
        "url": "https://moodle.example/local/delegateaccount/pages/delegations.php?realuserid=7",
        "linklabel": "Open the delegations of Jane Doe"
    }
}}
<span class="d-flex align-items-center">
    {{> local_delegateaccount/shared/avatar }}
    <span class="d-flex flex-column">
        {{#url}}<a href="{{url}}"{{#linklabel}} title="{{linklabel}}"{{/linklabel}}>{{fullname}}</a>{{/url}}{{^url}}<b>{{fullname}}</b>{{/url}}
        {{#email}}<span class="small text-muted text-truncate">{{email}}</span>{{/email}}
    </span>
</span>
