{{!
    @template local_delegateaccount/admin/setting_tabs

    Tabs that group the settings of the plugin.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "tabs": [
            {"name": "general", "displayname": "General", "html": "<p>General settings</p>", "active": true},
            {"name": "capabilities", "displayname": "Capabilities", "html": "<p>Capability settings</p>", "active": false}
        ]
    }
}}
<ul class="nav nav-tabs" role="tablist">
    {{#tabs}}
        <li class="nav-item">
            <a href="#{{name}}" class="nav-link {{#active}}active{{/active}}" data-toggle="tab" data-bs-toggle="tab" role="tab"
                {{#active}}aria-selected="true"{{/active}}
                {{^active}}aria-selected="false" tabindex="-1"{{/active}}>{{displayname}}</a>
        </li>
    {{/tabs}}
</ul>
<div class="tab-content mt-3">
    {{#tabs}}
        <div class="tab-pane {{#active}}active{{/active}}" id="{{name}}" role="tabpanel">
            {{{html}}}
        </div>
    {{/tabs}}
</div>
