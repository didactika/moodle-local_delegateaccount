{{!
    @template local_delegateaccount/activity/page

    What was done through one delegation: its period, the search, the menu of the date and the events. The rows are loaded by
    local_delegateaccount/activity.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "id": "lda-activity",
        "config": "{\"delegationid\":3}",
        "subtitle": "What Jane Doe did as John Smith",
        "period": "From 1 November 2026 to No end date",
        "delegateduser": {
            "fullname": "John Smith",
            "hasimage": false,
            "initials": "JS",
            "size": 50
        },
        "mindate": "2026-11-01",
        "maxdate": "2026-11-30"
    }
}}
<div class="lda">
    <header class="d-grid gap-3 pb-3 border-bottom">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                {{#delegateduser}}{{> local_delegateaccount/shared/avatar }}{{/delegateduser}}
                <div>
                    <p class="h5 fw-bold mb-0">{{subtitle}}</p>
                    <p class="text-muted mb-0">{{period}}</p>
                </div>
            </div>
        </div>
    </header>
    <section id="{{id}}" data-region="list" data-config="{{config}}">
        <div class="card">
            <div class="d-flex align-items-center justify-content-between gap-3 px-3 py-2 border-bottom" data-region="filters">
                <div class="d-flex align-items-center gap-2 flex-grow-1">
                    <div class="position-relative d-flex align-items-center" role="search">
                        {{#pix}}a/search, core{{/pix}}
                        <label class="sr-only visually-hidden" for="{{id}}-search">{{#str}}activity_search, local_delegateaccount{{/str}}</label>
                        <input class="form-control" type="search" id="{{id}}-search" name="search" autocomplete="off"
                            placeholder="{{#str}}activity_search, local_delegateaccount{{/str}}">
                    </div>
                    <div data-region="filter-menus">
                        <div class="dropdown d-inline-flex" data-menu="date" data-min="{{mindate}}" data-max="{{maxdate}}">
                            <button type="button" class="custom-select form-select" data-menu-toggle aria-haspopup="true" aria-expanded="false"
                                aria-label="{{#str}}activity_filter_date, local_delegateaccount{{/str}}"><span data-region="menu-label"
                                data-label="{{#str}}activity_filter_date, local_delegateaccount{{/str}}">{{#str}}activity_filter_date, local_delegateaccount{{/str}}</span></button>
                            <button type="button" class="btn btn-link p-0" data-menu-clear hidden
                                title="{{#str}}clear{{/str}}: {{#str}}activity_filter_date, local_delegateaccount{{/str}}"
                                aria-label="{{#str}}clear{{/str}}: {{#str}}activity_filter_date, local_delegateaccount{{/str}}">{{#pix}}e/cancel, core{{/pix}}</button>
                            <div class="dropdown-menu show" role="group" aria-label="{{#str}}activity_filter_date, local_delegateaccount{{/str}}" hidden>
                                <button type="button" class="dropdown-item" data-preset="today">{{#str}}filter_date_today, local_delegateaccount{{/str}}</button>
                                <button type="button" class="dropdown-item" data-preset="week">{{#str}}filter_date_week, local_delegateaccount{{/str}}</button>
                                <button type="button" class="dropdown-item" data-preset="month">{{#str}}filter_date_month, local_delegateaccount{{/str}}</button>
                                <button type="button" class="dropdown-item" data-preset="last30">{{#str}}filter_date_last30, local_delegateaccount{{/str}}</button>
                                <hr>
                                <div class="d-grid gap-2 px-3 pt-2 pb-3">
                                    <div class="d-flex gap-2">
                                        <div class="flex-fill">
                                            <label class="form-label small mb-1" for="{{id}}-from">{{#str}}activity_filter_datefrom, local_delegateaccount{{/str}}</label>
                                            <input class="form-control form-control-sm" type="date" id="{{id}}-from" name="datefrom" min="{{mindate}}" max="{{maxdate}}">
                                        </div>
                                        <div class="flex-fill">
                                            <label class="form-label small mb-1" for="{{id}}-to">{{#str}}activity_filter_dateto, local_delegateaccount{{/str}}</label>
                                            <input class="form-control form-control-sm" type="date" id="{{id}}-to" name="dateto" min="{{mindate}}" max="{{maxdate}}">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <button type="button" class="btn btn-link btn-icon" data-action="reset-filters" disabled
                        title="{{#str}}clear_filters, local_delegateaccount{{/str}}" aria-label="{{#str}}clear_filters, local_delegateaccount{{/str}}">{{#pix}}i/reload, core{{/pix}}</button>
                </div>
            </div>
            <div class="table-responsive" data-region="tablewrap" aria-busy="true">
                <table class="table">
                    <caption class="sr-only visually-hidden">{{#str}}list_caption_activity, local_delegateaccount{{/str}}</caption>
                    <tbody>
                        <tr aria-hidden="true"><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td></tr>
                        <tr aria-hidden="true"><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td></tr>
                    </tbody>
                </table>
            </div>
            <div data-region="empty" hidden></div>
            <div data-region="error" hidden></div>
            {{> local_delegateaccount/list/pager }}
        </div>
    </section>
</div>
