{{!
    @template local_delegateaccount/activity/table

    One page of the activity of a delegation, newest first.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "rows": [
            {
                "time": "5 November 2026, 10:42:11",
                "eventname": "Course viewed",
                "eventurl": "https://moodle.example/course/view.php?id=2",
                "description": "The user with id '8' viewed the course with id '2'.",
                "component": "System",
                "contextname": "Course: Algebra I",
                "contexturl": "https://moodle.example/course/view.php?id=2",
                "relateduser": "",
                "ip": "192.0.2.1"
            }
        ]
    }
}}
<table class="table">
    <caption class="sr-only visually-hidden">{{#str}}list_caption_activity, local_delegateaccount{{/str}}</caption>
    <thead>
        <tr>
            <th scope="col">{{#str}}time{{/str}}</th>
            <th scope="col">{{#str}}activity_event, local_delegateaccount{{/str}}</th>
            <th scope="col">{{#str}}activity_context, local_delegateaccount{{/str}}</th>
            <th scope="col">{{#str}}activity_related, local_delegateaccount{{/str}}</th>
            <th scope="col">{{#str}}activity_ip, local_delegateaccount{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
            <tr>
                <td class="text-nowrap"><span class="d-flex flex-column">{{time}}</span></td>
                <th scope="row">
                    <span class="d-flex flex-column">
                        {{#eventurl}}<a href="{{eventurl}}">{{eventname}}</a>{{/eventurl}}{{^eventurl}}{{eventname}}{{/eventurl}}
                        <span class="small text-muted text-truncate" title="{{description}}">{{component}} · {{description}}</span>
                    </span>
                </th>
                <td>{{#contexturl}}<a href="{{contexturl}}">{{contextname}}</a>{{/contexturl}}{{^contexturl}}{{contextname}}{{/contexturl}}</td>
                <td>{{relateduser}}{{^relateduser}}-{{/relateduser}}</td>
                <td class="text-nowrap">{{ip}}{{^ip}}-{{/ip}}</td>
            </tr>
        {{/rows}}
    </tbody>
</table>
