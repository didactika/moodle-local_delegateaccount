{{!
    @template local_delegateaccount/permission_editor

    The permission editor: what each permission does, the search, the filters and every capability with its permission in
    one flat list, and the bar of the unsaved changes. The rows are loaded by local_delegateaccount/permission_editor.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "id": "lda-permissions",
        "config": "{\"delegationid\":0,\"fieldname\":\"s_local_delegateaccount_sessioncapabilities\",\"site\":true}",
        "site": true
    }
}}
<div class="lda pb-5 ignoredirty" id="{{id}}" data-config="{{config}}">
    <p class="dd-page-subtitle mb-0">{{#site}}{{#str}}perm_intro_site, local_delegateaccount{{/str}}{{/site}}{{^site}}{{#str}}perm_intro_delegation, local_delegateaccount{{/str}}{{/site}}</p>
    <ul class="row list-unstyled small text-muted mb-0" aria-label="{{#str}}perm_legend, local_delegateaccount{{/str}}">
        <li class="col-sm-6 col-lg-3 mb-2"><b class="d-block text-body">{{#str}}perm_notset, local_delegateaccount{{/str}}</b>{{#str}}perm_notset_desc, local_delegateaccount{{/str}}</li>
        <li class="col-sm-6 col-lg-3 mb-2"><b class="d-block text-body">{{#str}}permissionallow, local_delegateaccount{{/str}}</b>{{#str}}perm_allow_desc, local_delegateaccount{{/str}}</li>
        <li class="col-sm-6 col-lg-3 mb-2"><b class="d-block text-body">{{#str}}perm_prevent, local_delegateaccount{{/str}}</b>{{#str}}perm_prevent_desc, local_delegateaccount{{/str}}</li>
        <li class="col-sm-6 col-lg-3 mb-2"><b class="d-block text-body">{{#str}}permissionprohibit, local_delegateaccount{{/str}}</b>{{#str}}perm_prohibit_desc, local_delegateaccount{{/str}}</li>
    </ul>
    <div class="alert alert-info mb-0" data-region="readonly" hidden>{{#str}}perm_readonly, local_delegateaccount{{/str}}</div>
    <div class="alert alert-info mb-0" role="status" data-region="notice" hidden></div>
    <div class="card">
        <div class="table-toolbar">
            <div class="table-toolbar-start">
                <div class="dd-searchbox" role="search">
                    {{#pix}}a/search, core{{/pix}}
                    <label class="sr-only visually-hidden" for="{{id}}-search">{{#str}}perm_search, local_delegateaccount{{/str}}</label>
                    <input class="form-control" type="search" id="{{id}}-search" data-region="search" autocomplete="off"
                        placeholder="{{#str}}perm_search_placeholder, local_delegateaccount{{/str}}">
                </div>
                <label class="sr-only visually-hidden" for="{{id}}-component">{{#str}}perm_component_all, local_delegateaccount{{/str}}</label>
                <span class="dd-select-filter">
                    <select class="custom-select form-select dd-select" id="{{id}}-component" data-region="component">
                        <option value="" hidden>{{#str}}perm_component_all, local_delegateaccount{{/str}}</option>
                    </select>
                    <button type="button" class="dd-select-clear" data-action="clearcomponent" hidden
                        title="{{#str}}clear{{/str}}: {{#str}}perm_component_all, local_delegateaccount{{/str}}"
                        aria-label="{{#str}}clear{{/str}}: {{#str}}perm_component_all, local_delegateaccount{{/str}}">{{#pix}}e/cancel, core{{/pix}}</button>
                </span>
            </div>
            <div class="table-toolbar-end">
                {{^site}}
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-action="copyfrom" hidden>{{#pix}}t/copy, core{{/pix}} {{#str}}copy_from_delegation, local_delegateaccount{{/str}}</button>
                {{/site}}
            </div>
        </div>
        <div class="table-toolbar">
            <div class="dd-chips" role="group" aria-label="{{#str}}perm_search, local_delegateaccount{{/str}}">
                <button type="button" class="dd-chip" data-filter="" aria-pressed="true">{{#str}}perm_filter_all, local_delegateaccount{{/str}} <span class="dd-chip-count" data-count="all">&nbsp;</span></button>
                <button type="button" class="dd-chip" data-filter="overridden" aria-pressed="false">{{#str}}perm_filter_overridden, local_delegateaccount{{/str}} <span class="dd-chip-count" data-count="overridden">&nbsp;</span></button>
                <button type="button" class="dd-chip" data-filter="1" aria-pressed="false">{{#str}}permissionallow, local_delegateaccount{{/str}} <span class="dd-chip-count" data-count="1">&nbsp;</span></button>
                <button type="button" class="dd-chip" data-filter="-1" aria-pressed="false">{{#str}}perm_prevent, local_delegateaccount{{/str}} <span class="dd-chip-count" data-count="-1">&nbsp;</span></button>
                <button type="button" class="dd-chip" data-filter="-1000" aria-pressed="false">{{#str}}permissionprohibit, local_delegateaccount{{/str}} <span class="dd-chip-count" data-count="-1000">&nbsp;</span></button>
                <button type="button" class="dd-chip" data-filter="risky" aria-pressed="false">{{#str}}perm_filter_risky, local_delegateaccount{{/str}} <span class="dd-chip-count" data-count="risky">&nbsp;</span></button>
            </div>
        </div>
        <div class="overflow-auto" data-region="capabilities">
            <div data-region="rows" aria-busy="true">
                <ul class="list-group list-group-flush" aria-hidden="true">
                    <li class="list-group-item"><span class="dd-skeleton w-50"></span></li>
                    <li class="list-group-item"><span class="dd-skeleton w-50"></span></li>
                    <li class="list-group-item"><span class="dd-skeleton w-50"></span></li>
                </ul>
            </div>
            <div data-region="empty" hidden>
                <div class="dd-empty">
                    <span class="dd-tile dd-tile-lg">{{#pix}}a/search, core{{/pix}}</span>
                    <p class="dd-empty-title">{{#str}}perm_empty_title, local_delegateaccount{{/str}}</p>
                    <p class="dd-empty-text">{{#str}}perm_empty_text, local_delegateaccount{{/str}}</p>
                    <button type="button" class="btn btn-outline-secondary" data-action="clearfilters">{{#str}}clear_filters, local_delegateaccount{{/str}}</button>
                </div>
            </div>
            <div data-region="error" hidden></div>
        </div>
        {{> local_delegateaccount/list/pager }}
    </div>
    <div class="dd-savebar" role="region" aria-live="polite" aria-label="{{#str}}session_permissions, local_delegateaccount{{/str}}" data-region="savebar" hidden>
        <span class="dd-savebar-text" data-region="unsaved"></span>
        <span class="dd-savebar-actions">
            <button type="button" class="btn btn-outline-secondary" data-action="discard">{{#str}}perm_discard, local_delegateaccount{{/str}}</button>
            <button type="button" class="btn btn-primary" data-action="save">{{#str}}savechanges{{/str}}</button>
        </span>
    </div>
</div>
