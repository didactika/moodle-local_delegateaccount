{{!
    @template local_delegateaccount/permission_editor

    The permission editor: what each permission does, the search, the menus of the component and of the permission, every
    capability with its permission in one flat list, and the bar of the unsaved changes. The rows are loaded by local_delegateaccount/permission_editor.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "id": "lda-permissions",
        "config": "{\"delegationid\":0,\"fieldname\":\"s_local_delegateaccount_sessioncapabilities\",\"site\":true}",
        "site": true
    }
}}
<div class="lda pb-5 ignoredirty" id="{{id}}" data-config="{{config}}">
    <div class="d-flex flex-wrap align-items-start">
        <p class="text-muted mb-0 mr-3 me-3">{{#site}}{{#str}}perm_intro_site, local_delegateaccount{{/str}}{{/site}}{{^site}}{{#str}}perm_intro_delegation, local_delegateaccount{{/str}}{{/site}}</p>
        {{^site}}
            <button type="button" class="btn btn-outline-secondary btn-sm ml-auto ms-auto" data-action="copyfrom" hidden>{{#pix}}t/copy, core{{/pix}} {{#str}}copy_from_delegation, local_delegateaccount{{/str}}</button>
        {{/site}}
    </div>
    <ul class="row list-unstyled small text-muted mb-0" data-region="legend" aria-label="{{#str}}perm_legend, local_delegateaccount{{/str}}">
        <li class="col-sm-6 col-lg-3"><b class="d-block text-body">{{#str}}perm_notset, local_delegateaccount{{/str}}</b>{{#str}}perm_notset_desc, local_delegateaccount{{/str}}</li>
        <li class="col-sm-6 col-lg-3"><b class="d-block text-body">{{#str}}permissionallow, local_delegateaccount{{/str}}</b>{{#str}}perm_allow_desc, local_delegateaccount{{/str}}</li>
        <li class="col-sm-6 col-lg-3"><b class="d-block text-body">{{#str}}perm_prevent, local_delegateaccount{{/str}}</b>{{#str}}perm_prevent_desc, local_delegateaccount{{/str}}</li>
        <li class="col-sm-6 col-lg-3"><b class="d-block text-body">{{#str}}permissionprohibit, local_delegateaccount{{/str}}</b>{{#str}}perm_prohibit_desc, local_delegateaccount{{/str}}</li>
    </ul>
    <div class="alert alert-info mb-0" data-region="readonly" hidden>{{#str}}perm_readonly, local_delegateaccount{{/str}}</div>
    <div class="alert alert-info mb-0" role="status" data-region="notice" hidden></div>
    <div class="card">
        <div class="d-flex align-items-center justify-content-between gap-3 px-3 py-2 border-bottom" data-region="filters">
            <div class="d-flex align-items-center gap-2 flex-grow-1">
                <div class="position-relative d-flex align-items-center" role="search">
                    {{#pix}}a/search, core{{/pix}}
                    <label class="sr-only visually-hidden" for="{{id}}-search">{{#str}}perm_search, local_delegateaccount{{/str}}</label>
                    <input class="form-control" type="search" id="{{id}}-search" data-region="search" autocomplete="off"
                        placeholder="{{#str}}perm_search_placeholder, local_delegateaccount{{/str}}">
                </div>
                <div data-region="filter-menus">
                    <label class="sr-only visually-hidden" for="{{id}}-component">{{#str}}perm_component_all, local_delegateaccount{{/str}}</label>
                    <span class="dropdown d-inline-flex">
                        <select class="custom-select form-select" id="{{id}}-component" data-region="component">
                            <option value="" hidden>{{#str}}perm_component_all, local_delegateaccount{{/str}}</option>
                        </select>
                        <button type="button" class="btn btn-link p-0" data-menu-clear data-action="clearcomponent" hidden
                            title="{{#str}}clear{{/str}}: {{#str}}perm_component_all, local_delegateaccount{{/str}}"
                            aria-label="{{#str}}clear{{/str}}: {{#str}}perm_component_all, local_delegateaccount{{/str}}">{{#pix}}e/cancel, core{{/pix}}</button>
                    </span>
                    <span class="dropdown d-inline-flex" data-menu="permission">
                        <button type="button" class="custom-select form-select" data-menu-toggle aria-haspopup="true" aria-expanded="false"
                            aria-label="{{#str}}perm_filter, local_delegateaccount{{/str}}"><span data-region="menu-label" data-label="{{#str}}perm_filter, local_delegateaccount{{/str}}">{{#str}}perm_filter, local_delegateaccount{{/str}}</span></button>
                        <button type="button" class="btn btn-link p-0" data-menu-clear data-action="clearfilter" hidden
                            title="{{#str}}clear{{/str}}: {{#str}}perm_filter, local_delegateaccount{{/str}}"
                            aria-label="{{#str}}clear{{/str}}: {{#str}}perm_filter, local_delegateaccount{{/str}}">{{#pix}}e/cancel, core{{/pix}}</button>
                        <span class="dropdown-menu show" role="listbox" aria-label="{{#str}}perm_filter, local_delegateaccount{{/str}}" hidden>
                            <button type="button" class="dropdown-item" role="option" data-filter="overridden" aria-selected="false"><span>{{#str}}perm_filter_overridden, local_delegateaccount{{/str}}</span> <span class="badge text-bg-secondary ms-auto" data-count="overridden"></span></button>
                            <button type="button" class="dropdown-item" role="option" data-filter="1" aria-selected="false"><span>{{#str}}permissionallow, local_delegateaccount{{/str}}</span> <span class="badge text-bg-secondary ms-auto" data-count="1"></span></button>
                            <button type="button" class="dropdown-item" role="option" data-filter="-1" aria-selected="false"><span>{{#str}}perm_prevent, local_delegateaccount{{/str}}</span> <span class="badge text-bg-secondary ms-auto" data-count="-1"></span></button>
                            <button type="button" class="dropdown-item" role="option" data-filter="-1000" aria-selected="false"><span>{{#str}}permissionprohibit, local_delegateaccount{{/str}}</span> <span class="badge text-bg-secondary ms-auto" data-count="-1000"></span></button>
                            <button type="button" class="dropdown-item" role="option" data-filter="risky" aria-selected="false"><span>{{#str}}perm_filter_risky, local_delegateaccount{{/str}}</span> <span class="badge text-bg-secondary ms-auto" data-count="risky"></span></button>
                        </span>
                    </span>
                        <div class="dropdown" data-menu="filters" hidden>
                        <button type="button" class="custom-select form-select" data-menu-toggle aria-haspopup="true" aria-expanded="false"
                            aria-label="{{#str}}filters{{/str}}">{{#pix}}i/filter, core{{/pix}} <span data-region="menu-label"
                            data-label="{{#str}}filters{{/str}}">{{#str}}filters{{/str}}</span></button>
                        <div class="dropdown-menu show dropdown-menu-end dropdown-menu-right" role="group" aria-label="{{#str}}filters{{/str}}" hidden>
                            <div data-region="filter-panel"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <button type="button" class="btn btn-link btn-icon" data-action="resetfilters" disabled
                    title="{{#str}}clear_filters, local_delegateaccount{{/str}}" aria-label="{{#str}}clear_filters, local_delegateaccount{{/str}}">{{#pix}}i/reload, core{{/pix}}</button>
            </div>
        </div>
        <div class="overflow-auto" data-region="capabilities">
            <div data-region="rows" aria-busy="true">
                <ul class="list-group list-group-flush" aria-hidden="true">
                    <li class="list-group-item"><span class="placeholder w-50"></span></li>
                    <li class="list-group-item"><span class="placeholder w-50"></span></li>
                    <li class="list-group-item"><span class="placeholder w-50"></span></li>
                </ul>
            </div>
            <div data-region="empty" hidden>
                <div class="d-flex flex-column align-items-center gap-2 px-4 py-5 text-center">
                    <span class="icon-box">{{#pix}}a/search, core{{/pix}}</span>
                    <p class="fw-bold mb-0">{{#str}}perm_empty_title, local_delegateaccount{{/str}}</p>
                    <p class="text-muted mb-0">{{#str}}perm_empty_text, local_delegateaccount{{/str}}</p>
                    <button type="button" class="btn btn-outline-secondary" data-action="clearfilters">{{#str}}clear_filters, local_delegateaccount{{/str}}</button>
                </div>
            </div>
            <div data-region="error" hidden></div>
        </div>
        {{> local_delegateaccount/list/pager }}
    </div>
    <div class="card" role="region" aria-live="polite" aria-label="{{#str}}session_permissions, local_delegateaccount{{/str}}" data-region="savebar" hidden>
        <span class="fw-bold text-nowrap" data-region="unsaved"></span>
        <span class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary" data-action="discard">{{#str}}perm_discard, local_delegateaccount{{/str}}</button>
            <button type="button" class="btn btn-primary" data-action="save">{{#str}}savechanges{{/str}}</button>
        </span>
    </div>
</div>
