{{!
    @template local_delegateaccount/permissions/rows

    The capabilities shown by the permission editor, under the name of their component, each with its permission as a
    segmented control.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "groups": [
            {
                "label": "System",
                "rows": [
                    {
                        "name": "moodle/user:editownprofile",
                        "label": "Edit own user profile",
                        "risks": [
                            {
                                "label": "Privacy"
                            }
                        ],
                        "changed": false,
                        "sitelabel": "Site: Prohibit",
                        "options": [
                            {
                                "value": 0,
                                "label": "Not set",
                                "tone": "notset",
                                "checked": true,
                                "disabled": false
                            },
                            {
                                "value": 1,
                                "label": "Allow",
                                "tone": "allow",
                                "checked": false,
                                "disabled": false
                            },
                            {
                                "value": -1,
                                "label": "Prevent",
                                "tone": "prevent",
                                "checked": false,
                                "disabled": false
                            },
                            {
                                "value": -1000,
                                "label": "Prohibit",
                                "tone": "prohibit",
                                "checked": false,
                                "disabled": false
                            }
                        ],
                        "grouplabel": "Permission for Edit own user profile"
                    }
                ]
            }
        ]
    }
}}
<ul class="list-group list-group-flush">
    {{#groups}}
        <li class="list-group-item list-group-item-light">{{label}}</li>
        {{#rows}}
            <li class="list-group-item{{#changed}} list-group-item-primary{{/changed}}" data-capability="{{name}}">
                <span class="d-flex flex-column">
                    <span class="font-weight-bold fw-bold">{{label}}</span>
                    <span class="small text-muted">
                        <span class="mr-2 me-2">{{name}}</span>
                        {{#risks}}<span class="badge badge-outline text-bg-warning">{{label}}</span>{{/risks}}
                        {{#sitelabel}}<span class="badge badge-soft text-bg-secondary">{{sitelabel}}</span>{{/sitelabel}}
                    </span>
                </span>
                <span class="dd-segmented" role="radiogroup" aria-label="{{grouplabel}}">
                    {{#options}}
                        <button type="button" role="radio" data-permission="{{value}}" aria-checked="{{#checked}}true{{/checked}}{{^checked}}false{{/checked}}" tabindex="{{#checked}}0{{/checked}}{{^checked}}-1{{/checked}}"{{#disabled}} disabled{{/disabled}}{{#hint}} title="{{hint}}"{{/hint}}>{{label}}</button>
                    {{/options}}
                </span>
            </li>
        {{/rows}}
    {{/groups}}
</ul>
