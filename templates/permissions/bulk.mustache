{{!
    @template local_delegateaccount/permissions/bulk

    The body of the dialog that changes the session permissions of many delegations at once. It keeps one size: in one mode
    the capabilities of the site, to add by clicking, and the changes chosen, each with its new permission; in the other the
    delegations to copy from, and whether their overrides are added or replace the ones there.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "id": "lda-bulk",
        "copyonly": false
    }
}}
<div data-region="bulk">
    {{^copyonly}}
        <div class="dd-segmented" role="radiogroup" aria-label="{{#str}}bulk_mode, local_delegateaccount{{/str}}">
            <button type="button" role="radio" aria-checked="true" tabindex="0" data-mode="change">{{#str}}bulk_mode_change, local_delegateaccount{{/str}}</button>
            <button type="button" role="radio" aria-checked="false" tabindex="-1" data-mode="copy">{{#str}}bulk_mode_copy, local_delegateaccount{{/str}}</button>
        </div>
        <div data-region="change">
            <div>
                <label class="font-weight-bold fw-bold d-block mb-2" for="{{id}}-capability">{{#str}}bulk_add_capability, local_delegateaccount{{/str}}</label>
                <div class="dd-searchbox mw-100 mb-2">
                    {{#pix}}a/search, core{{/pix}}
                    <input class="form-control" type="search" id="{{id}}-capability" data-region="capsearch" autocomplete="off"
                        aria-controls="{{id}}-capresults" placeholder="{{#str}}perm_search_placeholder, local_delegateaccount{{/str}}">
                </div>
                <ul class="list-group" id="{{id}}-capresults" role="listbox" aria-multiselectable="true"
                    aria-label="{{#str}}bulk_add_capability, local_delegateaccount{{/str}}" data-region="capresults"></ul>
            </div>
            <div>
                <p class="font-weight-bold fw-bold d-block mb-2">{{#str}}bulk_changes, local_delegateaccount{{/str}} <span data-region="changecount"></span></p>
                <p class="text-muted mb-0" data-region="nochanges">{{#str}}bulk_changes_empty, local_delegateaccount{{/str}}</p>
                <ul class="list-group" data-region="changes"></ul>
            </div>
        </div>
    {{/copyonly}}
    <div data-region="copy"{{^copyonly}} hidden{{/copyonly}}>
        <div class="mb-3">
            <label class="font-weight-bold fw-bold d-block mb-2" for="{{id}}-source">{{#str}}bulk_copy_source, local_delegateaccount{{/str}}</label>
            <div class="dd-searchbox mw-100 mb-2">
                {{#pix}}a/search, core{{/pix}}
                <input class="form-control" type="search" id="{{id}}-source" data-region="sourcesearch" autocomplete="off"
                    aria-controls="{{id}}-sourceresults" placeholder="{{#str}}search_delegations, local_delegateaccount{{/str}}">
            </div>
            <ul class="list-group" id="{{id}}-sourceresults" role="listbox"
                aria-label="{{#str}}bulk_copy_source, local_delegateaccount{{/str}}" data-region="sourceresults"></ul>
        </div>
        {{^copyonly}}
            <p class="font-weight-bold fw-bold d-block mb-2">{{#str}}bulk_copy_how, local_delegateaccount{{/str}}</p>
            <ul class="row list-unstyled mb-0">
                <li class="col-sm-6 mb-2"><label class="card card-body flex-row h-100 mb-0"><input type="radio" name="{{id}}-replace" value="0" checked><span class="ml-3 ms-3"><b class="d-block">{{#str}}bulk_copy_merge, local_delegateaccount{{/str}}</b><small class="text-muted">{{#str}}bulk_copy_merge_desc, local_delegateaccount{{/str}}</small></span></label></li>
                <li class="col-sm-6 mb-2"><label class="card card-body flex-row h-100 mb-0"><input type="radio" name="{{id}}-replace" value="1"><span class="ml-3 ms-3"><b class="d-block">{{#str}}bulk_copy_replace, local_delegateaccount{{/str}}</b><small class="text-muted">{{#str}}bulk_copy_replace_desc, local_delegateaccount{{/str}}</small></span></label></li>
            </ul>
        {{/copyonly}}
    </div>
    <div class="alert alert-danger mb-0" role="alert" data-region="error" hidden></div>
</div>
