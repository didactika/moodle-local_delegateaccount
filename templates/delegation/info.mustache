{{!
    @template local_delegateaccount/delegation/info

    Read-only lifecycle and audit details for one delegated-account relationship.

    @author     Hector Arrechea <hectorlazaroarrechea@gmail.com>
    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "statuslabel": "Status",
        "status": "Active",
        "authoriseduserlabel": "Real user",
        "authoriseduser": "Jane Doe",
        "delegateduserlabel": "Delegated account (target)",
        "delegateduser": "John Doe",
        "startlabel": "Access starts",
        "start": "Friday, 21 August 2026, 10:00 AM",
        "endlabel": "Access ends",
        "end": "No end date",
        "notificationmodelabel": "Notify affected users",
        "notificationmode": "Send a notification",
        "createdlabel": "Created",
        "created": "Friday, 21 August 2026, 10:00 AM",
        "createdbylabel": "Created by",
        "createdby": "Administrator",
        "modifiedlabel": "Last modified",
        "modified": "Friday, 21 August 2026, 10:00 AM",
        "modifiedbylabel": "Last modified by",
        "modifiedby": "Administrator",
        "isrevoked": false
    }
}}
<dl class="row">
    <dt class="col-sm-4">{{statuslabel}}</dt>
    <dd class="col-sm-8">{{status}}</dd>
    <dt class="col-sm-4">{{authoriseduserlabel}}</dt>
    <dd class="col-sm-8">{{{authoriseduser}}}</dd>
    <dt class="col-sm-4">{{delegateduserlabel}}</dt>
    <dd class="col-sm-8">{{{delegateduser}}}</dd>
    <dt class="col-sm-4">{{startlabel}}</dt>
    <dd class="col-sm-8">{{start}}</dd>
    <dt class="col-sm-4">{{endlabel}}</dt>
    <dd class="col-sm-8">{{end}}</dd>
    <dt class="col-sm-4">{{notificationmodelabel}}</dt>
    <dd class="col-sm-8">{{notificationmode}}</dd>
    <dt class="col-sm-4">{{createdlabel}}</dt>
    <dd class="col-sm-8">{{created}}</dd>
    <dt class="col-sm-4">{{createdbylabel}}</dt>
    <dd class="col-sm-8">{{createdby}}</dd>
    <dt class="col-sm-4">{{modifiedlabel}}</dt>
    <dd class="col-sm-8">{{modified}}</dd>
    <dt class="col-sm-4">{{modifiedbylabel}}</dt>
    <dd class="col-sm-8">{{modifiedby}}</dd>
    {{#isrevoked}}
        <dt class="col-sm-4">{{revokedlabel}}</dt>
        <dd class="col-sm-8">{{revoked}}</dd>
        <dt class="col-sm-4">{{revokedbylabel}}</dt>
        <dd class="col-sm-8">{{revokedby}}</dd>
    {{/isrevoked}}
</dl>
