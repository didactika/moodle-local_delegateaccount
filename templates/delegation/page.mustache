{{!
    @template local_delegateaccount/delegation/page

    One delegation in depth: who may open which account, its status and actions, and its sections as tabs: the summary,
    with its details and its history, and the session permissions.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "id": 3,
        "label": "Jane Doe as John Smith",
        "statuslabel": "Active",
        "statustone": "success",
        "realuser": {
            "fullname": "Jane Doe",
            "email": "jane@example.com",
            "hasimage": false,
            "initials": "JD"
        },
        "delegateduser": {
            "fullname": "John Smith",
            "email": "john@example.com",
            "hasimage": false,
            "initials": "JS"
        },
        "canupdate": true,
        "canrevoke": true,
        "activityurl": "https://moodle.example/local/delegateaccount/pages/activity.php?realuserid=7&delegationid=3",
        "realuserid": 7,
        "tabs": [
            {
                "label": "Summary",
                "url": "https://moodle.example/x",
                "active": true
            },
            {
                "label": "Session permissions",
                "url": "https://moodle.example/y",
                "active": false,
                "count": 2
            }
        ],
        "summary": true,
        "details": [
            {
                "label": "Access starts",
                "value": "1 November 2026"
            }
        ],
        "history": [
            {
                "title": "Created by Admin User",
                "meta": "1 November 2026",
                "tone": "success"
            }
        ],
        "editor": ""
    }
}}
<div class="lda" data-region="delegation" data-id="{{id}}" data-realuserid="{{realuserid}}">
    <header class="d-grid gap-3 pb-3 border-bottom">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                {{#headuser}}{{> local_delegateaccount/shared/avatar }}{{/headuser}}
                <div>
                    <p class="h5 fw-bold mb-0">{{label}}</p>
                    <p class="text-muted mb-0"><span class="badge text-bg-{{statustone}}">{{statuslabel}}</span></p>
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                {{#activityurl}}
                    <a class="btn btn-outline-secondary" href="{{activityurl}}">{{#pix}}i/log, core{{/pix}} {{#str}}view_delegated_activity, local_delegateaccount{{/str}}</a>
                {{/activityurl}}
                {{#canupdate}}
                    <button type="button" class="btn btn-outline-secondary" data-action="edit">{{#pix}}t/edit, core{{/pix}} {{#str}}edit_period, local_delegateaccount{{/str}}</button>
                {{/canupdate}}
                {{#canrevoke}}
                    <button type="button" class="btn btn-outline-danger" data-action="revoke">{{#pix}}t/delete, core{{/pix}} {{#str}}revoke, local_delegateaccount{{/str}}</button>
                {{/canrevoke}}
            </div>
        </div>
    </header>
    <nav aria-label="{{label}}">
        <ul class="nav nav-tabs">
            {{#tabs}}
                <li class="nav-item">
                    <a class="nav-link{{#active}} active{{/active}}" href="{{url}}"{{#active}} aria-current="page"{{/active}}>{{label}}{{#count}} <span class="badge text-bg-primary">{{count}}</span>{{/count}}</a>
                </li>
            {{/tabs}}
        </ul>
    </nav>
    {{#summary}}
        <div class="row" data-region="cards">
            <div class="col-lg-6">
            <section class="card h-100"><div class="card-body">
                <h2 class="card-title">{{#str}}details{{/str}}</h2>
                <dl class="row mx-0 mb-0">
                    {{#realuser}}
                        <dt class="col-sm-4 fw-normal text-muted px-0 py-2 mb-0 border-bottom">{{#str}}authoriseduser, local_delegateaccount{{/str}}</dt>
                        <dd class="col-sm-8 px-0 py-2 mb-0 border-bottom">{{> local_delegateaccount/shared/person }}</dd>
                    {{/realuser}}
                    {{#delegateduser}}
                        <dt class="col-sm-4 fw-normal text-muted px-0 py-2 mb-0 border-bottom">{{#str}}delegateduser, local_delegateaccount{{/str}}</dt>
                        <dd class="col-sm-8 px-0 py-2 mb-0 border-bottom">{{> local_delegateaccount/shared/person }}</dd>
                    {{/delegateduser}}
                    {{#details}}
                        <dt class="col-sm-4 fw-normal text-muted px-0 py-2 mb-0 border-bottom">{{label}}</dt>
                        <dd class="col-sm-8 px-0 py-2 mb-0 border-bottom">{{value}}</dd>
                    {{/details}}
                </dl>
            </div></section>
            </div>
            <div class="col-lg-6">
            <section class="card h-100"><div class="card-body">
                <h2 class="card-title">{{#str}}delegation_history, local_delegateaccount{{/str}}</h2>
                <ol class="list-unstyled d-grid gap-3 mb-0">
                    {{#history}}
                        <li class="d-flex gap-2">
                            <span class="{{#tone}}text-{{tone}}{{/tone}}{{^tone}}text-primary{{/tone}}" aria-hidden="true">&#9679;</span>
                            <span class="d-flex flex-column">
                                <span class="fw-bold">{{title}}</span>
                                <span class="small text-muted">{{meta}}</span>
                            </span>
                        </li>
                    {{/history}}
                </ol>
            </div></section>
            </div>
        </div>
    {{/summary}}
    {{{editor}}}
</div>
