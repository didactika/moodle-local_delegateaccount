{{!
    @template local_delegateaccount/manage_actions

    Moodle-native actions and collapsible filters for delegation management.

    @author     Hector Arrechea <hectorlazaroarrechea@gmail.com>
    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="d-flex justify-content-end mb-3">
    {{#cancreate}}
        <a class="btn btn-primary mr-2" href="{{assignurl}}">{{addlabel}}</a>
    {{/cancreate}}
    <button class="btn btn-secondary" type="button" data-action="local_delegateaccount-toggle-manage-filters"
        data-target="#local-delegateaccount-manage-filters" aria-controls="local-delegateaccount-manage-filters"
        aria-expanded="{{#showfilters}}true{{/showfilters}}{{^showfilters}}false{{/showfilters}}">
        {{#pix}}i/filter, core, {{filterlabel}}{{/pix}}
        {{filterlabel}}
    </button>
</div>
<div id="local-delegateaccount-manage-filters" class="collapse{{#showfilters}} show{{/showfilters}}">
    <div class="card card-body mb-3">
        {{{filterform}}}
        {{#hasfilters}}
            <div><a href="{{reseturl}}">{{resetlabel}}</a></div>
        {{/hasfilters}}
    </div>
</div>
