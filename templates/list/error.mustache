{{!
    @template local_delegateaccount/list/error

    What a list shows where its rows were when they did not load, with the way to try again.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "message": "The list did not load: the server did not answer in time."
    }
}}
<div class="alert alert-danger d-flex flex-wrap align-items-center justify-content-between" role="status">
    <span>{{message}}</span>
    <button type="button" class="btn btn-outline-danger btn-sm" data-action="retry">{{#str}}try_again, local_delegateaccount{{/str}}</button>
</div>
