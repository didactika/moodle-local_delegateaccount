{{!
    @template local_delegateaccount/list/delegations_table

    One page of a list of delegations. A row is opened by the name of its account; its quick actions are at the end.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "showrealuser": true,
        "canselect": true,
        "canpermissions": true,
        "rows": [
            {
                "id": 3,
                "label": "Jane Doe as John Smith",
                "realuser": {
                    "fullname": "Jane Doe",
                    "email": "jane@example.com",
                    "hasimage": false,
                    "initials": "JD",
                    "profileurl": "https://moodle.example/user/profile.php?id=7"
                },
                "delegateduser": {
                    "fullname": "John Smith",
                    "email": "john@example.com",
                    "hasimage": false,
                    "initials": "JS",
                    "profileurl": "https://moodle.example/user/profile.php?id=8"
                },
                "statuslabel": "Active",
                "statustone": "success",
                "start": "1/11/26, 10:00",
                "end": "No end date",
                "lastaccess": "No delegated access recorded",
                "overrides": 2,
                "overrideslabel": "Overrides: 2",
                "detailsurl": "https://moodle.example/local/delegateaccount/pages/delegation.php?realuserid=7&delegationid=3",
                "permissionsurl": "https://moodle.example/local/delegateaccount/pages/delegation.php?realuserid=7&delegationid=3",
                "activityurl": "https://moodle.example/local/delegateaccount/pages/activity.php?realuserid=7&delegationid=3",
                "canupdate": true,
                "canrevoke": true,
                "canviewactivity": true,
                "selectable": true,
                "isselected": false
            }
        ]
    }
}}
<table class="table">
    <caption class="sr-only visually-hidden">{{#str}}list_caption_delegations, local_delegateaccount{{/str}}</caption>
    <thead>
        <tr>
            {{#canselect}}
                <th scope="col" class="table-select">
                    <input type="checkbox" class="form-check-input" data-region="selectpage" data-focuskey="selectpage" aria-label="{{#str}}select_page, local_delegateaccount{{/str}}">
                </th>
            {{/canselect}}
            <th scope="col" data-sort="account"><button type="button" class="table-sort" data-focuskey="sort-account">{{#str}}delegateduser, local_delegateaccount{{/str}}</button></th>
            {{#showrealuser}}
                <th scope="col" data-sort="user"><button type="button" class="table-sort" data-focuskey="sort-user">{{#str}}authoriseduser, local_delegateaccount{{/str}}</button></th>
            {{/showrealuser}}
            <th scope="col">{{#str}}delegation_status, local_delegateaccount{{/str}}</th>
            <th scope="col" data-sort="start"><button type="button" class="table-sort" data-focuskey="sort-start">{{#str}}delegation_period, local_delegateaccount{{/str}}</button></th>
            <th scope="col">{{#str}}last_access, local_delegateaccount{{/str}}</th>
            <th scope="col">{{#str}}session_permissions, local_delegateaccount{{/str}}</th>
            <th scope="col" class="table-actions"><span class="sr-only visually-hidden">{{#str}}actions{{/str}}</span></th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
            <tr data-id="{{id}}"{{#isselected}} class="table-active"{{/isselected}}>
                {{#canselect}}
                    <td class="table-select">
                        {{#selectable}}<input type="checkbox" class="form-check-input" data-region="selectrow" value="{{id}}" aria-label="{{#str}}select_row, local_delegateaccount, {{label}}{{/str}}"{{#isselected}} checked{{/isselected}}>{{/selectable}}
                    </td>
                {{/canselect}}
                <th scope="row">
                    {{#delegateduser}}{{> local_delegateaccount/shared/person }}{{/delegateduser}}
                </th>
                {{#showrealuser}}
                    <td>{{#realuser}}{{> local_delegateaccount/shared/person }}{{/realuser}}</td>
                {{/showrealuser}}
                <td><span class="badge badge-soft badge-dot text-bg-{{statustone}}">{{statuslabel}}</span></td>
                <td><span class="d-flex flex-column">{{start}}<small>{{end}}</small></span></td>
                <td><span class="d-flex flex-column"><small>{{lastaccess}}</small></span></td>
                <td>
                    {{#overrides}}<a class="badge badge-outline text-bg-primary" href="{{permissionsurl}}">{{overrideslabel}}</a>{{/overrides}}
                    {{^overrides}}<span class="small text-muted text-truncate">{{#str}}overrides_none, local_delegateaccount{{/str}}</span>{{/overrides}}
                </td>
                <td class="table-actions">
                    <button type="button" class="btn btn-link btn-icon btn-sm text-primary" data-action="edit" data-id="{{id}}" title="{{#str}}edit_period_of, local_delegateaccount, {{label}}{{/str}}" aria-label="{{#str}}edit_period_of, local_delegateaccount, {{label}}{{/str}}"{{^canupdate}} disabled{{/canupdate}}>{{#pix}}t/edit, core{{/pix}}</button>
                    <a class="btn btn-link btn-icon btn-sm text-info" href="{{permissionsurl}}" title="{{#str}}session_permissions_of, local_delegateaccount, {{label}}{{/str}}" aria-label="{{#str}}session_permissions_of, local_delegateaccount, {{label}}{{/str}}">{{#pix}}i/permissions, core{{/pix}}</a>
                    {{#canviewactivity}}
                        <a class="btn btn-link btn-icon btn-sm text-success" href="{{activityurl}}" title="{{#str}}view_activity_of, local_delegateaccount, {{label}}{{/str}}" aria-label="{{#str}}view_activity_of, local_delegateaccount, {{label}}{{/str}}">{{#pix}}i/log, core{{/pix}}</a>
                    {{/canviewactivity}}
                    {{^canviewactivity}}
                        <span class="btn btn-link btn-icon btn-sm text-success disabled" aria-disabled="true" title="{{#str}}view_activity_of, local_delegateaccount, {{label}}{{/str}}">{{#pix}}i/log, core{{/pix}}</span>
                    {{/canviewactivity}}
                    <button type="button" class="btn btn-link btn-icon btn-sm text-danger" data-action="revoke" data-id="{{id}}" title="{{#str}}revoke_of, local_delegateaccount, {{label}}{{/str}}" aria-label="{{#str}}revoke_of, local_delegateaccount, {{label}}{{/str}}"{{^canrevoke}} disabled{{/canrevoke}}>{{#pix}}t/delete, core{{/pix}}</button>
                </td>
            </tr>
        {{/rows}}
    </tbody>
</table>
