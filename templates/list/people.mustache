{{!
    @template local_delegateaccount/list/people

    The people of the management page: search and the menu of the statuses of their delegations, the table and the pager. The rows
    are loaded by local_delegateaccount/people.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "id": "lda-people",
        "config": "{\"scope\":\"authorised\"}",
        "searchlabel": "Search people"
    }
}}
<section id="{{id}}" data-region="list" data-config="{{config}}" data-initial="{{initial}}">
    <div class="card">
        {{> local_delegateaccount/list/toolbar }}
        <div class="table-responsive" data-region="tablewrap" aria-busy="true">
            <table class="table">
                <caption class="sr-only visually-hidden">{{#str}}list_caption_people, local_delegateaccount{{/str}}</caption>
                <tbody>
                    <tr aria-hidden="true"><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td></tr>
                    <tr aria-hidden="true"><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td></tr>
                    <tr aria-hidden="true"><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td></tr>
                </tbody>
            </table>
        </div>
        <div data-region="empty" hidden></div>
        <div data-region="error" hidden></div>
        {{> local_delegateaccount/list/pager }}
    </div>
</section>
