{{!
    @template local_delegateaccount/list/pager

    The foot of a list: rows per page, which rows are shown, and the arrows.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "id": "lda-list"
    }
}}
<div class="table-foot" data-region="foot">
    <div class="dd-pager">
        <div class="dd-pager-size">
            <label for="{{id}}-perpage" class="mb-0">{{#str}}rows_per_page, local_delegateaccount{{/str}}</label>
            <select class="custom-select form-select form-select-sm custom-select-sm dd-select" id="{{id}}-perpage" data-region="perpage">
                <option value="12" selected>12</option>
                <option value="24">24</option>
                <option value="48">48</option>
                <option value="96">96</option>
                <option value="0">{{#str}}all{{/str}}</option>
            </select>
        </div>
        <div class="dd-pager-end">
            <span class="dd-pager-range" role="status" data-region="range"></span>
            <div class="dd-pager-arrows">
                <button type="button" class="btn btn-outline-secondary btn-sm btn-icon" data-action="prev" title="{{#str}}previous_page, local_delegateaccount{{/str}}" aria-label="{{#str}}previous_page, local_delegateaccount{{/str}}" disabled>{{#pix}}i/previous, core{{/pix}}</button>
                <button type="button" class="btn btn-outline-secondary btn-sm btn-icon" data-action="next" title="{{#str}}next_page, local_delegateaccount{{/str}}" aria-label="{{#str}}next_page, local_delegateaccount{{/str}}" disabled>{{#pix}}i/next, core{{/pix}}</button>
            </div>
        </div>
    </div>
</div>
