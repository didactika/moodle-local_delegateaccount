{{!
    @template local_delegateaccount/list/empty

    The empty state of a list: what is missing and what to do. After a search or a filter it offers to clear them; the first
    time it says how the first rows appear.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "filtered": false,
        "icon": "i/users",
        "title": "No delegations yet",
        "text": "Create delegations to let people open other accounts for a period."
    }
}}
<div class="dd-empty">
    {{#filtered}}
        <span class="dd-tile dd-tile-lg">{{#pix}}a/search, core{{/pix}}</span>
        <p class="dd-empty-title">{{#str}}empty_search_title, local_delegateaccount{{/str}}</p>
        <p class="dd-empty-text">{{#str}}empty_search_text, local_delegateaccount{{/str}}</p>
        <button type="button" class="btn btn-outline-secondary" data-action="clearfilters">{{#str}}clear_filters, local_delegateaccount{{/str}}</button>
    {{/filtered}}
    {{^filtered}}
        <span class="dd-tile dd-tile-lg">{{#pix}}{{icon}}{{^icon}}i/users{{/icon}}, core{{/pix}}</span>
        <p class="dd-empty-title">{{title}}</p>
        <p class="dd-empty-text">{{text}}</p>
    {{/filtered}}
</div>
